# ===== Azure OpenAI =====
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-chat-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ===== Docker-internal service addresses (IMPORTANT) =====
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=agent-documents

DATABASE_URL=postgresql://user:password@postgres:5432/agent_db

MILVUS_HOST=milvus
MILVUS_PORT=19530

# ===== Auth =====
JWT_SECRET_KEY=your_jwt_secret_key_here

# ===== Optional local defaults =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ALLOWED_ORIGINS=*
REDIS_HISTORY_TTL_SECONDS=3600

# ===== SonarQube =====
SONAR_TOKEN=your_sonar_token_here